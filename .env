# ─────────────────────────────────────────────────────────────────────────────
# GeoSeg environment config
# Copy this to .env and edit the paths to match your machine.
# ─────────────────────────────────────────────────────────────────────────────

# Path to your external drive / NAS / folder containing TIFFs + shapefiles
# This folder is mounted READ-ONLY into Docker — nothing will be written here.
#
# Examples:
#   Linux/Mac:   RAW_DATA_DIR=/media/username/SSD2TB/tiff_project
#   Windows WSL: RAW_DATA_DIR=/mnt/d/tiff_project
#   NAS:         RAW_DATA_DIR=/mnt/nas/geodata
#
RAW_DATA_DIR=D:\QGIS-DATASETS\CG_EXTRACT